# Dash⁵ backend — salin jadi .env, lalu isi bagian WAJIB dan SESUAIKAN.
# Nilai di sini contoh/default, bukan nilai produksi.

# ─── WAJIB — tanpa ini aplikasi tidak berfungsi ──────────────────────────────

# ID project Google Cloud (bukan project number). Kosong = setiap pertanyaan
# gagal, padahal container tetap Up dan /health tetap 200.
GOOGLE_CLOUD_PROJECT=

# Root domain Supabase berskema, TANPA path. Self-host: http://<ip-internal-db>:8000
SUPABASE_URL=

# ANON key Supabase, dipakai memverifikasi JWT teknisi. Salah isi = SEMUA endpoint 401.
SUPABASE_ANON_KEY=

# Cohere rerank. Kosong = rerank mati DIAM-DIAM dan mutu pencarian turun tanpa error.
COHERE_API_KEY=

# ─── SESUAIKAN — punya default, tapi defaultnya untuk deployment lama ────────

# Origin frontend, persis: ada https://, tanpa garis miring di akhir.
ALLOWED_ORIGIN=https://dash5.my.id

# Region Vertex untuk embedding & transcribe — samakan dengan lokasi server.
# Server di Indonesia: asia-southeast1 (terukur 0,35 dtk vs 2,19 dtk dari us-central1).
VERTEX_LOCATION=us-central1

# ─── BIARKAN kecuali tahu persis alasannya ───────────────────────────────────

VERTEX_MODEL=gemini-3.7-flash

# Model di luar daftar ini ditolak 400. Mengisi variabel ini MENGGANTI seluruh default.
ALLOWED_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite,gemini-3.1-flash-lite-preview,gemini-2.5-flash

COHERE_RERANK_MODEL=rerank-v4.0-fast
RATE_LIMIT_PER_MIN=150
AUTH_CACHE_TTL_MS=60000
