# WAJIB
GOOGLE_CLOUD_PROJECT=
SUPABASE_URL=
SUPABASE_ANON_KEY=
COHERE_API_KEY=

# SESUAIKAN
ALLOWED_ORIGIN=https://dash5.my.id
VERTEX_LOCATION=asia-southeast1
# Opsional: embedding lewat AI Studio (kuota lebih besar); kosong = Vertex saja.
GEMINI_API_KEY=

# Model: utama + cadangan harus BERBEDA, kalau sama cadangannya hilang.
VERTEX_MODEL=gemini-3.7-flash
FALLBACK_MODELS=gemini-3.6-flash

# Rerank: Google Ranking API utama (akun layanan butuh roles/discoveryengine.viewer), Cohere cadangan.
# RERANKER=cohere mengembalikan ke Cohere tanpa deploy.
RERANKER=google
