{
  "name": "dash5-vertexai-proxy",
  "version": "1.0.0",
  "description": "Cloud Run proxy + server-side RAG orchestration for Dash5",
  "main": "server.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/orchestrator.cjs --log-level=warning",
    "typecheck": "tsc -p tsconfig.json",
    "test": "esbuild test/entry.ts --bundle --platform=node --target=node20 --format=cjs --outfile=test/.build/entry.cjs --log-level=warning && node test/run.cjs",
    "start": "node server.js"
  },
  "dependencies": {
    "@supabase/postgrest-js": "^1.16.0",
    "express": "^4.19.2",
    "google-auth-library": "^9.14.2",
    "undici": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
