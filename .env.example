# SUPABASE_URL: Your Supabase project URL
SUPABASE_URL="MY_SUPABASE_URL"

# SUPABASE_ANON_KEY: Your Supabase anonymous API key
SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_VERTEX_PROXY_URL: Cloud Run URL of the Vertex AI auth proxy (no trailing slash)
# Obtain this after running: gcloud run deploy dash5-vertexai-proxy ...
VITE_VERTEX_PROXY_URL="https://dash5-vertexai-proxy-xxxx-uc.a.run.app"

# VITE_VERTEX_MODEL: Vertex AI model to use (optional, default: gemini-2.0-flash-001)
VITE_VERTEX_MODEL="gemini-2.0-flash-001"
