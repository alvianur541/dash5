# Dash⁵ frontend — salin jadi .env, lalu isi.
# Nilai ditanam saat `npm run build`. Mengubah file ini tanpa build ulang
# tidak berpengaruh apa pun — ini sumber kebingungan paling sering.
#
# Hanya empat variabel ini yang dibaca aplikasi. Model AI diatur dari backend
# lewat VERTEX_MODEL, bukan dari sini.

# Root domain Supabase. Aplikasi menambahkan /rest/v1 dan /auth/v1 sendiri.
VITE_SUPABASE_URL=

# ANON key Supabase — memang terlihat di browser, dilindungi RLS. Bukan service role.
VITE_SUPABASE_ANON_KEY=

# Alamat backend. Cloudflare: /api  ·  nginx sendiri: https://<hostname>/api
# Frontend menambahkan /v1/ sendiri, jadi JANGAN diakhiri /v1.
VITE_VERTEX_PROXY_URL=/api

# always | never | adaptive (default kalau kosong atau nilai tak dikenal).
VITE_AGENTIC_MODE=adaptive
