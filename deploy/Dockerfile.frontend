FROM node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .

ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_VERTEX_PROXY_URL
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL \
    VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY \
    VITE_VERTEX_PROXY_URL=$VITE_VERTEX_PROXY_URL

RUN for v in VITE_SUPABASE_URL VITE_SUPABASE_ANON_KEY VITE_VERTEX_PROXY_URL; do \
      eval "isi=\$$v"; \
      [ -n "$isi" ] || { echo "GAGAL: $v kosong — isi berkas .env lebih dulu"; exit 1; }; \
    done && npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY deploy/nginx-frontend.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
